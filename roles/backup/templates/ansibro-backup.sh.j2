#!/usr/bin/env bash
# Back up this server ({{ inventory_hostname }}) with restic. Made by ansibro, do not change it here.
# Runs every night at {{ backup_time }} (ansibro-backup.timer).
#
#   sudo ansibro-backup              back up now
#   sudo ansibro-backup snapshots    list the backups of this server (add --json for a program)
#
# Each server has its own repository and password, {{ backup_repository }}.
#
# What it saves:
#   - databases (PostgreSQL, MariaDB) as a dump, while they run
#   - every other app folder in {{ apps_dir }}: the app is paused for a moment while its files are copied
#   - big object storage (RustFS, Garage data) as it is, while it runs
#   - k3s: the volumes on this server (local-path), while they run
#   - monitoring: Grafana and Alertmanager, but not the metrics and logs history
#   - first manager: the swarm (your stacks, secrets, networks) or a k3s snapshot, and config.yml and
#     state/secrets/ encrypted for the installer's age key (installer.tar.age)
# Not saved: the image registry (the installer fills it again; push your own images again: sudo ansibro-registry open).
set -euo pipefail
set -a
. {{ backup_dir }}/restic.env
set +a

if [ "${1:-}" = "snapshots" ]; then
  shift
  exec restic snapshots "$@"
fi

stage={{ backup_dir }}/stage
rm -rf "$stage"
mkdir -p "$stage/apps" "$stage/dumps"

# If the script stops in the middle, never leave an app paused.
paused=""
trap 'if [ -n "$paused" ]; then docker unpause $paused >/dev/null || true; fi' EXIT

# Pause the containers of one app, copy its folder, unpause. $2 = a folder to leave out.
copy_app() {
  paused=$( (docker ps -q --filter "label=com.docker.compose.project=$1"
             docker ps -q --filter "label=com.docker.stack.namespace=$1") | sort -u | tr '\n' ' ')
  if [ -n "$paused" ]; then docker pause $paused >/dev/null; fi
  mkdir -p "$stage/apps/$1"
  find "{{ apps_dir }}/$1" -mindepth 1 -maxdepth 1 ! -name "${2:-.}" -exec cp -a {} "$stage/apps/$1/" \;
  if [ -n "$paused" ]; then docker unpause $paused >/dev/null; fi
  paused=""
}

# 1. Databases: a dump is consistent while the database runs.
# A dump that does not work is reported at the end, but the app folders below are still saved.
failed=""
{% if 'postgres' in node_apps %}
dump_postgres() {
  docker exec postgres pg_dumpall -U postgres --clean --if-exists > "$stage/dumps/postgres.sql"
}
# (Only on the primary. A PostgreSQL replica is a copy of it; with Patroni the primary can move.)
{% if postgres_patroni %}
# Find the primary. During a failover there is none for a moment: wait for one (up to 2 minutes).
primary=""
for _ in $(seq 24); do
  for ip in {{ app_nodes.postgres | map('extract', hostvars, 'node_ip') | join(' ') }}; do
    if [ "$(curl -s -m 5 -o /dev/null -w '%{http_code}' "http://$ip:8008/primary")" = 200 ]; then
      primary=$ip
      break 2
    fi
  done
  sleep 5
done
if [ -z "$primary" ]; then
  echo "error: no PostgreSQL server is the primary, so the database was not saved" >&2
  failed="$failed postgres"
elif [ "$primary" = "{{ node_ip }}" ]; then
{% else %}
if docker ps -q --filter name=^postgres$ | grep -q .; then
{% endif %}
  if ! dump_postgres; then
    echo "error: the PostgreSQL dump did not work" >&2
    rm -f "$stage/dumps/postgres.sql"
    failed="$failed postgres"
  fi
fi
{% endif %}
{% if 'mariadb' in node_apps %}
# Users as CREATE USER and GRANT, not the "mysql" database itself: its tables belong to this
# server (and to Galera), and loading them on a new server breaks it. Left out:
# - the users the image makes itself on a new server: root, healthcheck, mariadb.sys (root gets the
#   saved password there; replacing the user that loads the dump would also break the load)
# - the "IF current_user() ... END IF */|" blocks: they only guard those users
# Only user lines (DROP USER, CREATE ... USER, GRANT, ...) of those users are left out, never data lines.
# (A user line looks like: CREATE /*M!100103 OR REPLACE */ USER `root`@`%` ...)
dump_mariadb() {
  docker exec mariadb sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" mariadb-dump -uroot --all-databases \
    --ignore-database=mysql --system=users --replace --single-transaction --routines --events \
    --add-drop-database' \
    | LC_ALL=C awk '/^\/\*M!100101 IF current_user\(\)/ { skip = 1 } !skip { print } /^END IF \*\// { skip = 0 }' \
    | LC_ALL=C grep -a -v -E "^(/\*M?![0-9]* *)?(CREATE|GRANT|REVOKE|DROP|ALTER USER|SET DEFAULT ROLE)[^;]* [\`']?(root|healthcheck|mariadb\.sys)[\`']?@" \
    > "$stage/dumps/mariadb.sql"
}
{% if mariadb_galera %}
# (Galera: every server has all the data, so only one server saves it: the first one that is in sync.
# Each server asks the same check as database-proxy, in the same order, so they pick the same one.)
dumper=""
for ip in {{ app_nodes.mariadb | map('extract', hostvars, 'node_ip') | join(' ') }}; do
  if [ "$(curl -s -m 5 -o /dev/null -w '%{http_code}' "http://$ip:{{ mariadb_check_port }}/")" = 200 ]; then
    dumper=$ip
    break
  fi
done
if [ -z "$dumper" ]; then
  echo "error: no MariaDB server is in sync, so the database was not saved" >&2
  failed="$failed mariadb"
elif [ "$dumper" = "{{ node_ip }}" ]; then
{% else %}
if docker ps -q --filter name=^mariadb$ | grep -q .; then
{% endif %}
  if ! dump_mariadb; then
    echo "error: the MariaDB dump did not work" >&2
    rm -f "$stage/dumps/mariadb.sql"
    failed="$failed mariadb"
  fi
fi
{% endif %}

# 2. App folders.
paths=("$stage")
for dir in {{ apps_dir }}/*/; do
  app=$(basename "$dir")
  case "$app" in
    backup | bundle | registry) ;;          # not saved
    etcd) ;;                                # Patroni's state: made again from the new database
    postgres | mariadb) ;;                  # saved as a dump above
    rustfs) paths+=("$dir") ;;              # big: saved while it runs
    redis | valkey) copy_app "$app" sentinel ;;      # Sentinel's state (old primary): made again
    victoria) copy_app "$app" data ;;                # metrics and logs history: not saved
    monitoring-agent) copy_app "$app" vector-data ;;  # logs waiting to be sent: not saved
    garage) copy_app garage data            # settings and metadata paused, data while it runs
            paths+=("{{ apps_dir }}/garage/data") ;;
    *) copy_app "$app" ;;
  esac
done
{% if orchestrator == 'k3s' and inventory_hostname in groups['swarm'] %}
# k3s volumes on this server (local-path, like Traefik's certificates): saved while they run.
if [ -d /var/lib/rancher/k3s/storage ]; then
  paths+=(/var/lib/rancher/k3s/storage)
fi
{% endif %}
{% if inventory_hostname == swarm_leader %}

# 3. First manager: the cluster state, and the installer files (config.yml, state/secrets/), encrypted.
{% if orchestrator == 'swarm' %}
cp -a /var/lib/docker/swarm "$stage/swarm"
{% else %}
# k3s: a snapshot of its database (etcd), with everything you deployed.
rm -rf "$stage/k3s"
mkdir -p "$stage/k3s"
k3s etcd-snapshot save --dir "$stage/k3s" --name ansibro >/dev/null
{% endif %}
if [ -d {{ backup_dir }}/installer ]; then
  cp -a {{ backup_dir }}/installer "$stage/installer"
fi
{% endif %}

# 4. Send it to the repository, then delete old backups of this server.
restic backup --quiet --retry-lock 1h --host {{ inventory_hostname }} --tag ansibro "${paths[@]}"
restic forget --quiet --retry-lock 1h --host {{ inventory_hostname }} --prune \
  --keep-daily {{ backup_keep_daily }} --keep-weekly {{ backup_keep_weekly }} --keep-monthly {{ backup_keep_monthly }}

rm -rf "$stage"
if [ -n "$failed" ]; then
  echo "error: backup of {{ inventory_hostname }} saved, but without:$failed" >&2
  exit 1
fi
date +%s > {{ backup_dir }}/last-success
echo "Backup of {{ inventory_hostname }} done."
