services:
  beszel-agent:
    image: {{ registry_addr }}/beszel-agent:{{ images['beszel-agent'].tag }}
    container_name: beszel-agent
    restart: always
    # Host network: it reports this server's real network stats.
    network_mode: host
    environment:
      LISTEN: "{{ beszel_agent_port }}"
{# to_json quotes the key, so it stays one value (tasks/agent.yml checks it too). #}
      KEY: {{ beszel_hub_key.content | b64decode | trim | to_json }}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
