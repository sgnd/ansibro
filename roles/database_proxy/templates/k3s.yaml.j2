# app: {{ database_app }} (the installer removes this file when the app is removed)
# database-proxy on k3s: cluster apps connect to database-proxy.ansibro.svc.cluster.local (5432 or 3306). Made by ansibro.
apiVersion: v1
kind: ConfigMap
metadata: { name: database-proxy, namespace: ansibro }
data:
  haproxy.cfg: |
    {{ lookup('ansible.builtin.template', 'haproxy.cfg.j2') | indent(4) }}
---
apiVersion: apps/v1
kind: Deployment
metadata: { name: database-proxy, namespace: ansibro }
spec:
  replicas: 2
  selector: { matchLabels: { app: database-proxy } }
  template:
    metadata:
      labels: { app: database-proxy }
      annotations: { ansibro/config: "{{ database_proxy_config.checksum }}" }
    spec:
      # No service links: Kubernetes would add variables like <SERVICE>_PORT, which apps read as settings.
      enableServiceLinks: false
      containers:
        - name: haproxy
          image: {{ image_ref.haproxy }}
          ports: [{ containerPort: {{ database_port }} }]
          volumeMounts: [{ name: config, mountPath: /usr/local/etc/haproxy }]
      volumes:
        - { name: config, configMap: { name: database-proxy } }
---
apiVersion: v1
kind: Service
metadata: { name: database-proxy, namespace: ansibro }
spec:
  selector: { app: database-proxy }
  ports: [{ port: {{ database_port }} }]
