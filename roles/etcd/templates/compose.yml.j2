# etcd: Patroni (PostgreSQL on more servers) keeps here which server is the primary.
# One member on each manager. Made by ansibro.
services:
  etcd:
    image: {{ image_ref.etcd }}
    container_name: etcd
    restart: always
    # Host network: the firewall decides who can connect.
    network_mode: host
    command:
      - etcd
      - --name={{ inventory_hostname }}
      - --data-dir=/etcd-data
      - --listen-client-urls=http://{{ node_ip }}:{{ etcd_client_port }},http://127.0.0.1:{{ etcd_client_port }}
      - --advertise-client-urls=http://{{ node_ip }}:{{ etcd_client_port }}
      - --listen-peer-urls=http://{{ node_ip }}:{{ etcd_peer_port }}
      - --initial-advertise-peer-urls=http://{{ node_ip }}:{{ etcd_peer_port }}
      - --initial-cluster={% for host in groups['managers'] %}{{ host }}=http://{{ hostvars[host].node_ip }}:{{ etcd_peer_port }}{{ ',' if not loop.last }}{% endfor %}

      - --initial-cluster-token={{ etcd_token }}
      - --initial-cluster-state=new
      # Patroni writes every few seconds; etcd keeps old values until they are compacted.
      # Without this, etcd fills up after some weeks and Patroni stops the primary.
      - --auto-compaction-mode=periodic
      - --auto-compaction-retention=1h
    volumes:
      - ./data:/etcd-data
