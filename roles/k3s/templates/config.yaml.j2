# k3s settings for {{ inventory_hostname }}. Made by ansibro, do not change it here.
{% if k3s_server %}
# Servers: the server token, and the agent token that the workers join with.
token: "{{ k3s_token }}"
agent-token: "{{ k3s_agent_token }}"
{% else %}
# Workers: only the agent token (it cannot read the cluster's keys; the server token can).
token: "{{ k3s_agent_token }}"
{% endif %}
node-name: {{ inventory_hostname }}
node-ip: {{ node_ip }}
# NodePorts (30000-32767) skip the firewall, so they answer only on node_ip, not on a public address.
kube-proxy-arg: ["nodeport-addresses={{ node_ip }}/32"]
{% if k3s_flannel_iface %}
flannel-iface: {{ k3s_flannel_iface }}
{% endif %}
{% if k3s_server %}
advertise-address: {{ node_ip }}
tls-san: [{{ node_ip }}, {{ node_host }}]
write-kubeconfig-mode: "0600"
{% if inventory_hostname == swarm_leader %}
cluster-init: true  # embedded etcd, so more servers can join
{% else %}
server: {{ k3s_url }}
{% endif %}
{% if 'traefik' not in apps %}
disable: [traefik]
{% endif %}
{% else %}
server: {{ k3s_url }}
{% endif %}
{% if node_labels %}
node-label:
{% for key, value in node_labels.items() %}
  - "{{ key }}={{ value }}"
{% endfor %}
{% endif %}
