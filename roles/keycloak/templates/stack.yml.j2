services:
  keycloak:
    image: {{ image_ref.keycloak }}
    # Keycloak reads no *_FILE settings: its two passwords come from the swarm secrets when it starts
    # ($$: a $ for Docker; "$(< file)" is bash for the text of the file).
    entrypoint: ["/bin/bash", "-c", "export KC_DB_PASSWORD=\"$$(< /run/secrets/db_password)\" KC_BOOTSTRAP_ADMIN_PASSWORD=\"$$(< /run/secrets/admin_password)\" && exec /opt/keycloak/bin/kc.sh \"$$@\"", "kc.sh"]
    command: start
    secrets:
      - { source: db_password, target: db_password }
      - { source: admin_password, target: admin_password }
    environment:
      KC_DB: {{ database_app }}
      KC_DB_URL_HOST: {{ database_host }}
      KC_DB_URL_DATABASE: keycloak
      KC_DB_USERNAME: keycloak
      KC_HOSTNAME: https://{{ keycloak_host }}
      # Traefik handles HTTPS and tells Keycloak the real address.
      KC_HTTP_ENABLED: "true"
      KC_PROXY_HEADERS: xforwarded
      KC_HEALTH_ENABLED: "true"
      # Only used the first time, to create the admin user (its password: see entrypoint).
      KC_BOOTSTRAP_ADMIN_USERNAME: admin
    # Ready = Keycloak answers on /health/ready (port 9000). The image has no curl, so bash does the request.
    healthcheck:
      test: ["CMD-SHELL", "exec 3<>/dev/tcp/127.0.0.1/9000 && printf 'GET /health/ready HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\n\\r\\n' >&3 && grep -q '200 OK' <&3"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 120s
    networks:
      - public
    deploy:
      replicas: 1
{% if swarm_app_constraint %}
      placement:
        constraints:
          - {{ swarm_app_constraint }}
{% endif %}
      labels:
        traefik.enable: "true"
        traefik.http.routers.keycloak.rule: Host(`{{ keycloak_host }}`)
        traefik.http.routers.keycloak.service: keycloak
        # The admin console and admin API only from admin_allow_from (the longer rule wins).
        # The rest (/realms: the logins) stays open, because apps and users log in there.
        # Not behind the admin login: Keycloak is that login (admin_sso), and if its realm broke you could
        # not get in to fix it. The master admin password (state/secrets/keycloak_admin) guards it.
        traefik.http.routers.keycloak-admin.rule: Host(`{{ keycloak_host }}`) && PathPrefix(`/admin`)
        traefik.http.routers.keycloak-admin.service: keycloak
        traefik.http.routers.keycloak-admin.middlewares: admin-ip@file
        traefik.http.services.keycloak.loadbalancer.server.port: "8080"

{% if admin_sso == 'keycloak' %}

  # The Keycloak login in front of the admin pages (Traefik middleware "admin").
  oauth2-proxy:
    image: {{ image_ref['oauth2-proxy'] }}
    command:
{% for arg in keycloak_oauth_args %}
      - "{{ arg }}"
{% endfor %}
      - --client-secret-file=/run/secrets/oauth_client_secret
      - --cookie-secret-file=/run/secrets/oauth_cookie_secret
    secrets:
      - { source: oauth_client_secret, target: oauth_client_secret }
      - { source: oauth_cookie_secret, target: oauth_cookie_secret }
    networks:
      - public
    deploy:
      replicas: 1
      labels:
        traefik.enable: "true"
        traefik.http.routers.oauth.rule: Host(`{{ keycloak_oauth_host }}`)
        traefik.http.services.oauth.loadbalancer.server.port: "4180"
{% endif %}

# The name changes with the file (keycloak_secret_sums in tasks/main.yml), so a new password reaches Keycloak.
secrets:
{% for name in ['db_password', 'admin_password'] + (['oauth_client_secret', 'oauth_cookie_secret'] if admin_sso == 'keycloak' else []) %}
  {{ name }}:
    name: keycloak-{{ name | replace('_', '-') }}-{{ keycloak_secret_sums[name] }}
    file: ./secrets/{{ name }}
{% endfor %}

networks:
  public:
    external: true
