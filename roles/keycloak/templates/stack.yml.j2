services:
  keycloak:
    image: {{ registry_addr }}/keycloak:{{ images.keycloak.tag }}
    command: start
    environment:
      KC_DB: {{ database_app }}
      KC_DB_URL_HOST: {{ database_host }}
      KC_DB_URL_DATABASE: keycloak
      KC_DB_USERNAME: keycloak
      KC_DB_PASSWORD: {{ keycloak_db_password }}
      KC_HOSTNAME: https://{{ keycloak_host }}
      # Traefik handles HTTPS and tells Keycloak the real address.
      KC_HTTP_ENABLED: "true"
      KC_PROXY_HEADERS: xforwarded
      KC_HEALTH_ENABLED: "true"
      # Only used the first time, to create the admin user.
      KC_BOOTSTRAP_ADMIN_USERNAME: admin
      KC_BOOTSTRAP_ADMIN_PASSWORD: {{ keycloak_admin_password }}
    # Ready = Keycloak answers on /health/ready (port 9000). The image has no curl, so bash does the request.
    healthcheck:
      test: ["CMD-SHELL", "exec 3<>/dev/tcp/127.0.0.1/9000 && printf 'GET /health/ready HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\n\\r\\n' >&3 && grep -q '200 OK' <&3"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 120s
    networks:
      - public
    deploy:
      replicas: 1
{% if swarm_app_constraint %}
      placement:
        constraints:
          - {{ swarm_app_constraint }}
{% endif %}
      labels:
        traefik.enable: "true"
        traefik.http.routers.keycloak.rule: Host(`{{ keycloak_host }}`)
        traefik.http.routers.keycloak.service: keycloak
        # The admin console and admin API only from admin_allow_from (the longer rule wins).
        # The rest (/realms: the logins) stays open, because apps and users log in there.
        # Not behind the admin login: Keycloak is that login (admin_sso), and if its realm broke you could
        # not get in to fix it. The master admin password (state/secrets/keycloak_admin) guards it.
        traefik.http.routers.keycloak-admin.rule: Host(`{{ keycloak_host }}`) && PathPrefix(`/admin`)
        traefik.http.routers.keycloak-admin.service: keycloak
        traefik.http.routers.keycloak-admin.middlewares: admin-ip@file
        traefik.http.services.keycloak.loadbalancer.server.port: "8080"

{% if admin_sso == 'keycloak' %}

  # The Keycloak login in front of the admin pages (Traefik middleware "admin").
  oauth2-proxy:
    image: {{ registry_addr }}/oauth2-proxy:{{ images['oauth2-proxy'].tag }}
    command:
{% for arg in keycloak_oauth_args %}
      - "{{ arg }}"
{% endfor %}
    environment:
      OAUTH2_PROXY_CLIENT_SECRET: {{ keycloak_oauth_client_secret }}
      OAUTH2_PROXY_COOKIE_SECRET: {{ keycloak_oauth_cookie_secret }}
    networks:
      - public
    deploy:
      replicas: 1
      labels:
        traefik.enable: "true"
        traefik.http.routers.oauth.rule: Host(`{{ keycloak_oauth_host }}`)
        traefik.http.services.oauth.loadbalancer.server.port: "4180"
{% endif %}

networks:
  public:
    external: true
