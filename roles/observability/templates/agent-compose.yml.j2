# Monitoring agents on {{ inventory_hostname }}. The monitoring server ({{ monitoring_ip }}) collects from them.
# Host network: the firewall decides who can connect. They listen on {{ node_ip }} only.
services:
  node-exporter:
    image: {{ image_ref['node-exporter'] }}
    container_name: node-exporter
    restart: always
    network_mode: host
    pid: host
    command:
      - --path.rootfs=/host
      - --web.listen-address={{ node_ip }}:{{ observability_node_exporter_port }}
      # Metrics written by ansibro-metrics every minute.
      - --collector.textfile.directory=/host/var/lib/ansibro-metrics
      - --collector.filesystem.mount-points-exclude=^/(dev|proc|run|sys|var/lib/docker/.+|var/lib/containerd/.+)($|/)
    volumes:
      - /:/host:ro,rslave

  cadvisor:
    image: {{ image_ref.cadvisor }}
    container_name: cadvisor
    restart: always
    network_mode: host
    privileged: true
    devices: [/dev/kmsg]
    command:
      - --listen_ip={{ node_ip }}
      - --port={{ observability_cadvisor_port }}
{% if orchestrator == 'k3s' and inventory_hostname in groups['swarm'] %}
      # k3s pods run in k3s's own containerd, not in Docker: read those too.
      - --docker_only=false
      - --containerd=/var/run/k3s/containerd/containerd.sock
      - --whitelisted_container_labels=com.docker.compose.project,com.docker.swarm.service.name,io.kubernetes.container.name,io.kubernetes.pod.namespace
{% else %}
      - --docker_only=true
      - --whitelisted_container_labels=com.docker.compose.project,com.docker.swarm.service.name
{% endif %}
      - --housekeeping_interval=30s
      - --store_container_labels=false
      # Fewer metrics: less memory and disk on the monitoring server.
      - --disable_metrics=advtcp,cpu_topology,cpuset,hugetlb,memory_numa,percpu,process,referenced_memory,resctrl,sched,tcp,udp
    # The image checks localhost:8080; cAdvisor listens on this server's ip instead.
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://{{ node_ip }}:{{ observability_cadvisor_port }}/healthz"]
      interval: 30s
      timeout: 5s
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
      - /dev/disk:/dev/disk:ro

  vector:
    image: {{ image_ref.vector }}
    container_name: vector
    restart: always
    network_mode: host
    command: [--config, /etc/vector/vector.yaml]
    environment:
      # The containers' logs come through docker-proxy below, which lets Vector only read them.
      DOCKER_HOST: unix:///run/docker-proxy/docker.sock
    depends_on: [docker-proxy]
    volumes:
      - ./vector.yaml:/etc/vector/vector.yaml:ro
      # Logs wait here while the monitoring server is down, and are sent later.
      - ./vector-data:/var/lib/vector
      - /run/ansibro-docker-proxy/vector:/run/docker-proxy:ro
{% if orchestrator == 'k3s' and inventory_hostname in groups['swarm'] %}
      - /var/log/pods:/var/log/pods:ro  # the logs of k3s pods
{% endif %}
      - /var/log/journal:/var/log/journal:ro
      - /run/log/journal:/run/log/journal:ro
      - /etc/machine-id:/etc/machine-id:ro

  # In front of the Docker socket for Vector: it may only list the containers, read their settings
  # and logs, and follow Docker's events. Its socket is in a folder only Vector gets, it has no network,
  # a read-only file system and no privileges.
  docker-proxy:
    image: {{ image_ref['socket-proxy'] }}
    container_name: vector-docker-proxy
    restart: always
    network_mode: none
    user: "0:0"  # to open the Docker socket; with every capability dropped
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    command:
      - -proxysocketendpoint=/run/docker-proxy/docker.sock
      - -allowGET={{ observability_socket_proxy_get | replace('$', '$$') }}  # $$: a $ for Docker Compose
      - -allowHEAD=^/(v[0-9.]+/)?_ping$$
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /run/ansibro-docker-proxy/vector:/run/docker-proxy
{% if 'postgres' in node_apps %}

  postgres-exporter:
    image: {{ image_ref['postgres-exporter'] }}
    container_name: postgres-exporter
    restart: always
    network_mode: host
    environment:
      DATA_SOURCE_URI: "{{ node_ip }}:5432/postgres?sslmode=disable"
      DATA_SOURCE_USER: monitor
      DATA_SOURCE_PASS: ${MONITOR_PASSWORD}  # from .env
    command: [--web.listen-address={{ node_ip }}:{{ observability_postgres_exporter_port }}]
{% endif %}
{% if 'mariadb' in node_apps %}

  mysqld-exporter:
    image: {{ image_ref['mysqld-exporter'] }}
    container_name: mysqld-exporter
    restart: always
    network_mode: host
    environment:
      MYSQLD_EXPORTER_PASSWORD: ${MONITOR_PASSWORD}  # from .env
    command:
      - --mysqld.address={{ node_ip }}:3306
      - --mysqld.username=monitor
      - --web.listen-address={{ node_ip }}:{{ observability_mysqld_exporter_port }}
{% endif %}
{% if node_apps | intersect(['redis', 'valkey']) %}

  # Works for Redis and Valkey.
  redis-exporter:
    image: {{ image_ref['redis-exporter'] }}
    container_name: redis-exporter
    restart: always
    network_mode: host
    environment:
      REDIS_PASSWORD: ${CACHE_PASSWORD}  # from .env
    command:
      - -redis.addr=redis://{{ node_ip }}:6379
      - -web.listen-address={{ node_ip }}:{{ observability_redis_exporter_port }}
{% endif %}
