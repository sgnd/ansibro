# What to collect, every 30 seconds. Each target has a "node" label: the server it runs on.
global:
  scrape_interval: 30s

scrape_configs:
  # On every server: the server itself (node-exporter), its containers (cAdvisor), the log agent (Vector).
{% for job, port in {'node': observability_node_exporter_port, 'cadvisor': observability_cadvisor_port, 'vector': observability_vector_port}.items() %}
  - job_name: {{ job }}
    static_configs:
{% for host in groups['all'] %}
      - targets: ["{{ hostvars[host].node_ip }}:{{ port }}"]
        labels: { node: {{ host }} }
{% endfor %}
{% if job == 'cadvisor' and orchestrator == 'k3s' %}
    # k3s pods: name is the container's name from Kubernetes, like a Docker container's name.
    metric_relabel_configs:
      - source_labels: [container_label_io_kubernetes_container_name]
        regex: (.+)
        target_label: name
{% endif %}
{% endfor %}

  # Database exporters, on each server where the database runs (replicas too).
{% for app, job, port in [
     ('postgres', 'postgres', observability_postgres_exporter_port),
     ('mariadb', 'mariadb', observability_mysqld_exporter_port),
     ('redis', 'redis', observability_redis_exporter_port),
     ('valkey', 'valkey', observability_redis_exporter_port)] if app in apps %}
  - job_name: {{ job }}
    static_configs:
{% for host in app_nodes[app] %}
      - targets: ["{{ hostvars[host].node_ip }}:{{ port }}"]
        labels: { node: {{ host }} }
{% endfor %}
{% endfor %}
{% if postgres_patroni %}

  # Patroni: which PostgreSQL server is the primary, and how far each replica is behind.
  - job_name: patroni
    static_configs:
{% for host in app_nodes.postgres %}
      - targets: ["{{ hostvars[host].node_ip }}:8008"]
        labels: { node: {{ host }} }
{% endfor %}
{% endif %}
{% if 'traefik' in apps %}

  # Traefik (Swarm or k3s): requests, backends that are down, and when the certificates end.
  - job_name: traefik
    static_configs:
{% for host in traefik_nodes %}
      - targets: ["{{ hostvars[host].node_ip }}:{{ observability_traefik_metrics_port }}"]
        labels: { node: {{ host }} }
{% endfor %}
{% endif %}
{% if 'rabbitmq' in apps %}

  - job_name: rabbitmq
    static_configs:
      - targets: ["{{ hostvars[apps.rabbitmq].node_ip }}:15692"]
        labels: { node: {{ apps.rabbitmq }} }
{% endif %}

  # The monitoring apps watch each other too.
  - job_name: monitoring
    static_configs:
      - targets:
          - "{{ node_ip }}:{{ observability_metrics_port }}"
          - "{{ node_ip }}:{{ observability_logs_port }}"
          - "{{ node_ip }}:{{ observability_grafana_port }}"
{% if monitoring_app == 'victoria' %}
          - "{{ node_ip }}:{{ observability_vmalert_port }}"
{% endif %}
        labels: { node: {{ inventory_hostname }} }

  # Alertmanager asks for its login.
  - job_name: alertmanager
    basic_auth:
      username: {{ alertmanager_user }}
      password_file: /etc/victoria/alertmanager-password
    static_configs:
      - targets: ["{{ node_ip }}:{{ observability_alertmanager_port }}"]
        labels: { node: {{ inventory_hostname }} }
