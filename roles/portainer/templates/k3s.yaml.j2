# app: portainer (the installer removes this file when the app is removed)
# Portainer on k3s: it manages the cluster it runs in, so it needs no agent. Made by ansibro.
apiVersion: v1
kind: ServiceAccount
metadata: { name: portainer, namespace: ansibro }
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata: { name: ansibro-portainer }
roleRef: { apiGroup: rbac.authorization.k8s.io, kind: ClusterRole, name: cluster-admin }
subjects: [{ kind: ServiceAccount, name: portainer, namespace: ansibro }]
---
apiVersion: apps/v1
kind: Deployment
metadata: { name: portainer, namespace: ansibro }
spec:
  replicas: 1
  strategy: { type: Recreate }
  selector: { matchLabels: { app: portainer } }
  template:
    metadata: { labels: { app: portainer } }
    spec:
      # No service links: Kubernetes would add variables like <SERVICE>_PORT, which apps read as settings.
      enableServiceLinks: false
      serviceAccountName: portainer
      # Its data stays on the first manager, like with Swarm (and the backup saves it there).
      nodeSelector: { kubernetes.io/hostname: {{ swarm_leader }} }
      containers:
        - name: portainer
          image: {{ image_ref.portainer }}
          args: [--admin-password-file, /run/admin_password]
          ports: [{ containerPort: 9000 }]
          volumeMounts:
            - { name: data, mountPath: /data }
            - { name: password, mountPath: /run/admin_password, readOnly: true }
      volumes:
        - { name: data, hostPath: { path: "{{ portainer_dir }}/data" } }
        - { name: password, hostPath: { path: "{{ portainer_dir }}/admin_password", type: File } }
---
apiVersion: v1
kind: Service
metadata: { name: portainer, namespace: ansibro }
spec:
  selector: { app: portainer }
  ports: [{ port: 9000 }]
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata: { name: portainer, namespace: ansibro }
spec:
  entryPoints: [websecure]
  routes:
    # Portainer has its own login; with Authelia or Keycloak, that login comes first.
    - match: Host(`{{ portainer_host }}`)
      kind: Rule
      middlewares: [{ name: admin-ip }{% if admin_sso %}, { name: "{{ k3s_admin_login }}" }{% endif %}]
      services: [{ name: portainer, port: 9000 }]
{% if admin_sso %}
    # The servers and pods, and portainer_open_paths, skip the Authelia or Keycloak login (not
    # admin_allow_from). The longer rule wins.
    - match: Host(`{{ portainer_host }}`) && ({{ admin_servers_rule }}{% for path in portainer_open_paths %} || PathPrefix(`{{ path }}`){% endfor %})
      kind: Rule
      middlewares: [{ name: admin-ip }]
      services: [{ name: portainer, port: 9000 }]
{% endif %}
  tls: {{ k3s_route_tls | to_json }}
