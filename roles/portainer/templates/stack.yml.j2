services:
  agent:
    image: {{ image_ref['portainer-agent'] }}
    environment:
      AGENT_SECRET: {{ portainer_agent_secret }}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /var/lib/docker/volumes:/var/lib/docker/volumes
    networks:
      - agent
    deploy:
      mode: global
      placement:
        constraints:
          - node.platform.os == linux

  portainer:
    image: {{ image_ref.portainer }}
    command: -H tcp://tasks.agent:9001 --tlsskipverify --admin-password-file /run/admin_password
    environment:
      AGENT_SECRET: {{ portainer_agent_secret }}
    volumes:
      - {{ portainer_dir }}/data:/data
      - {{ portainer_dir }}/admin_password:/run/admin_password:ro
    networks:
      - agent
      - public
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.hostname == {{ swarm_leader }}
      labels:
        traefik.enable: "true"
        traefik.http.routers.portainer.rule: Host(`{{ portainer_host }}`)
        # Portainer has its own login; with Authelia or Keycloak, admin@file asks for that login first.
        traefik.http.routers.portainer.middlewares: {{ 'admin@file' if admin_sso else 'admin-ip@file' }}
{% if admin_sso %}
        # The servers and portainer_open_paths skip the Authelia or Keycloak login (not admin_allow_from).
        # The longer rule wins. The agents talk to Portainer on the agent network, not through Traefik.
        traefik.http.routers.portainer-open.rule: Host(`{{ portainer_host }}`) && ({{ admin_servers_rule }}{% for path in portainer_open_paths %} || PathPrefix(`{{ path }}`){% endfor %})
        traefik.http.routers.portainer-open.middlewares: admin-ip@file
        traefik.http.routers.portainer-open.service: portainer
{% endif %}
        traefik.http.services.portainer.loadbalancer.server.port: "9000"

networks:
  agent:
    driver: overlay
    driver_opts:
      com.docker.network.driver.mtu: "{{ swarm_mtu }}"
  public:
    external: true
