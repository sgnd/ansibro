services:
  postgres:
    image: {{ image_ref.postgres }}
    container_name: postgres
    restart: always
    # Host network: the firewall decides who can connect.
    network_mode: host
    env_file: .env
    shm_size: 256mb
    volumes:
      - ./data:/var/lib/postgresql
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "postgres"]
      interval: 10s
      timeout: 5s
      retries: 5
