# PostgreSQL with Patroni (Spilo image), on {{ app_nodes.postgres | join(', ') }}. Made by ansibro.
services:
  postgres:
    image: {{ image_ref.spilo }}
    container_name: postgres
    restart: always
    # Host network: the firewall decides who can connect.
    network_mode: host
    env_file: .env
    environment:
      SCOPE: ansibro                       # the same on every server of this cluster
      PGVERSION: "{{ images.postgres.tag.split('.')[0] }}"
      ETCD3_HOSTS: "{{ postgres_etcd_hosts }}"
      SPILO_PROVIDER: local
      ALLOW_NOSSL: "true"                  # apps may connect without SSL, like the one-server PostgreSQL
      # This server's name and addresses are in SPILO_CONFIGURATION (.env): Spilo ignores PATRONI_* here.
    volumes:
      - ./data:/home/postgres/pgdata
    healthcheck:
      # Patroni runs. Not "PostgreSQL runs": a new replica first copies the whole database, which can
      # take long. The installer waits for the primary itself (tasks/find_primary.yml).
      test: ["CMD", "curl", "-sf", "http://localhost:8008/liveness"]
      interval: 10s
      timeout: 5s
      retries: 30
