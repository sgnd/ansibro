services:
  rabbitmq:
    image: {{ image_ref.rabbitmq }}
    container_name: rabbitmq
    restart: always
    # Host network: the firewall decides who can connect.
    network_mode: host
    env_file: .env
    volumes:
      - ./data:/var/lib/rabbitmq
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 10s
      timeout: 10s
      retries: 10
      start_period: 30s
