services:
  redis:
    image: {{ image_ref.redis }}
    container_name: redis
    restart: always
    # Host network: the firewall decides who can connect.
    network_mode: host
    command: ["redis-server", "/etc/redis.conf"]
    environment:
      # redis-cli reads the password from REDISCLI_AUTH, so it is not visible in the process list.
      REDISCLI_AUTH: "{{ redis_password }}"
    volumes:
      - ./redis.conf:/etc/redis.conf:ro
{% if redis_ha %}
      - ./replica.conf:/etc/redis-replica.conf:ro
{% endif %}
      - ./data:/data
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping | grep PONG"]
      interval: 10s
      timeout: 5s
      retries: 5
{% if redis_ha %}

  # Watches the primary and picks a new one when it is down. Apps can ask it where the primary is.
  redis-sentinel:
    image: {{ image_ref.redis }}
    container_name: redis-sentinel
    restart: always
    network_mode: host
    command: ["redis-server", "/etc/sentinel/sentinel.conf", "--sentinel"]
    environment:
      REDISCLI_AUTH: "{{ redis_password }}"
    volumes:
      - ./sentinel:/etc/sentinel  # Sentinel writes to its file
{% endif %}
