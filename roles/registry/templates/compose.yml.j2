name: registry

services:
  registry:
    image: {{ registry_image }}
    pull_policy: never  # the installer gets the image first (pull or offline bundle)
    restart: always
    # Host network so the port is filtered by UFW (published ports bypass it).
    network_mode: host
    environment:
      REGISTRY_HTTP_ADDR: "{{ node_ip }}:{{ registry_port }}"
      REGISTRY_HTTP_TLS_CERTIFICATE: /certs/registry.crt
      REGISTRY_HTTP_TLS_KEY: /certs/registry.key
      REGISTRY_AUTH: htpasswd
      REGISTRY_AUTH_HTPASSWD_REALM: ansibro
      REGISTRY_AUTH_HTPASSWD_PATH: /auth/htpasswd
    volumes:
      - ./config:/etc/distribution:ro  # a folder, so a changed config.yml shows up after a restart
      - ./auth:/auth:ro
      - ./certs:/certs:ro
      - ./data:/var/lib/registry
