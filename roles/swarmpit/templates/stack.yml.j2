services:
  app:
    image: {{ registry_addr }}/swarmpit:{{ images.swarmpit.tag }}
    environment:
      SWARMPIT_DB: http://db:5984
      SWARMPIT_INFLUXDB: http://influxdb:8086
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - swarmpit
      - public
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.hostname == {{ swarm_leader }}  # next to its databases; the installer makes its admin user here
{% if swarmpit_route %}
      # Only once the admin user is made: before, anyone who opens the page could make it.
      labels:
        traefik.enable: "true"
        traefik.http.routers.swarmpit.rule: Host(`{{ swarmpit_host }}`)
        # Swarmpit has its own login; with Authelia or Keycloak, admin@file asks for that login first.
        traefik.http.routers.swarmpit.middlewares: {{ 'admin@file' if admin_sso else 'admin-ip@file' }}
{% if admin_sso %}
        # The servers (Uptime Kuma checks from there) skip the Authelia or Keycloak login, not
        # admin_allow_from. The longer rule wins.
        traefik.http.routers.swarmpit-open.rule: Host(`{{ swarmpit_host }}`) && ({{ admin_servers_rule }})
        traefik.http.routers.swarmpit-open.middlewares: admin-ip@file
        traefik.http.routers.swarmpit-open.service: swarmpit
{% endif %}
        traefik.http.services.swarmpit.loadbalancer.server.port: "8080"
{% endif %}

  db:
    image: {{ registry_addr }}/couchdb:{{ images.couchdb.tag }}
    volumes:
      - {{ swarmpit_dir }}/couchdb:/opt/couchdb/data
    networks:
      - swarmpit
    deploy:
      placement:
        constraints:
          - node.hostname == {{ swarm_leader }}

  influxdb:
    image: {{ registry_addr }}/influxdb:{{ images.influxdb.tag }}
    volumes:
      - {{ swarmpit_dir }}/influxdb:/var/lib/influxdb
    networks:
      - swarmpit
    deploy:
      placement:
        constraints:
          - node.hostname == {{ swarm_leader }}

  agent:
    image: {{ registry_addr }}/swarmpit-agent:{{ images['swarmpit-agent'].tag }}
    environment:
      DOCKER_API_VERSION: "1.44"  # Docker 29 needs at least this API version
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - swarmpit
    deploy:
      mode: global
      labels:
        swarmpit.agent: "true"

networks:
  swarmpit:
    driver: overlay
    driver_opts:
      com.docker.network.driver.mtu: "{{ swarm_mtu }}"
  public:
    external: true
