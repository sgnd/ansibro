# Traefik on k3s (k3s has it built in). k3s applies this file by itself. Made by ansibro.
# Settings for the built-in Traefik: HTTP goes to HTTPS, and the certificates.
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    # No update checks and no usage data sent out (like Traefik on Swarm).
    globalArguments:
      - --global.checknewversion=false
      - --global.sendanonymoususage=false
    additionalArguments:
      - --entryPoints.web.http.redirections.entryPoint.to=websecure
      - --entryPoints.web.http.redirections.entryPoint.scheme=https
      - --api.dashboard=true
      - --providers.kubernetescrd.allowCrossNamespace=true  # routes use the middlewares in "ansibro"
{% if tls == 'letsencrypt' %}
      - --entryPoints.websecure.http.tls.certResolver=letsencrypt
      - --certificatesresolvers.letsencrypt.acme.email={{ acme_email }}
      - --certificatesresolvers.letsencrypt.acme.storage=/data/acme.json
      - --certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=web
{% if acme_server is defined %}
      - --certificatesresolvers.letsencrypt.acme.caserver={{ acme_server }}
{% endif %}
{% if acme_ca_cert is defined %}
      - --certificatesresolvers.letsencrypt.acme.cacertificates=/acme-ca/ca.crt
    # The ACME server's CA certificate (acme_ca_cert), from the secret below.
    volumes:
      - name: acme-ca
        mountPath: /acme-ca
        type: secret
{% endif %}
    # Keeps the certificates when Traefik restarts.
    persistence:
      enabled: true
    # One Traefik, on {{ traefik_nodes[0] }}: Let's Encrypt's check must reach the Traefik that asked.
    # Point DNS to that server.
    nodeSelector:
      kubernetes.io/hostname: {{ traefik_nodes[0] }}
{% else %}
    # A Traefik on each of {{ traefik_nodes | join(', ') }}, so each one answers on 80 and 443.
    # Point DNS to all of them.
    deployment:
      kind: DaemonSet
{% if traefik_nodes | length < groups['swarm'] | length %}
    nodeSelector:
      tier: app
{% endif %}
{% endif %}
    # Traefik takes ports 80 and 443 of its server itself (host ports), so it sees the visitor's real
    # IP: admin_allow_from needs it. k3s's own load balancer (ServiceLB) would hide it behind a pod
    # address, so the Traefik service is only inside the cluster. Only a server that runs Traefik answers.
    ports:
      web:
        hostPort: 80
      websecure:
        hostPort: 443
{% if monitoring_app %}
      # Metrics on port 8082 of each Traefik server, for the monitoring server
      # (the NetworkPolicy below lets only the cluster servers in).
      metrics:
        port: 8082
        hostPort: 8082
{% endif %}
    # (The chart takes the type under spec; a plain "service.type" is ignored.)
    service:
      spec:
        type: ClusterIP
    # A host port can be used by one Traefik per server only: stop the old one before the new one starts.
    updateStrategy:
      type: RollingUpdate
      rollingUpdate:
        maxUnavailable: 1
        maxSurge: 0
{% if monitoring_app %}
---
# The metrics port has no login: only the cluster servers may use it. Web ports are open to all.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: traefik-metrics
  namespace: kube-system
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: traefik
  policyTypes: [Ingress]
  ingress:
    - ports:
        - port: web
        - port: websecure
        - port: traefik  # its health check
    - from:
{% for host in groups['all'] %}
        - ipBlock: { cidr: "{{ hostvars[host].node_ip }}/32" }
{% endfor %}
      ports:
        - port: metrics
{% endif %}
{% if tls == 'letsencrypt' and acme_ca_cert is defined %}
---
apiVersion: v1
kind: Secret
metadata:
  name: acme-ca
  namespace: kube-system
data:
  ca.crt: {{ lookup('ansible.builtin.file', acme_ca_cert) | b64encode }}
{% endif %}
---
# Ansibro's own things (routes to server apps, admin logins) live in this namespace.
apiVersion: v1
kind: Namespace
metadata:
  name: ansibro
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: admin-ip
  namespace: ansibro
spec:
  ipAllowList:
    sourceRange:
{% for cidr in traefik_admin_allow_from %}
      - "{{ cidr }}"
{% endfor %}
---
apiVersion: v1
kind: Secret
metadata:
  name: admin-users
  namespace: ansibro
stringData:
  users: "admin:{{ traefik_password_hash.stdout }}"
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: admin-auth
  namespace: ansibro
spec:
  basicAuth:
    secret: admin-users
{% if 'authelia' in apps %}
---
# Authelia login (with a second factor on admin pages), like authelia@file with Swarm.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: authelia
  namespace: ansibro
spec:
  forwardAuth:
    address: http://authelia.ansibro.svc.cluster.local:9091/api/authz/forward-auth
    trustForwardHeader: true
    authResponseHeaders: [Remote-User, Remote-Groups, Remote-Email, Remote-Name]
{% endif %}
{% if admin_sso == 'keycloak' %}
---
# Keycloak login through oauth2-proxy (in the keycloak manifest).
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: oauth
  namespace: ansibro
spec:
  forwardAuth:
    address: http://oauth2-proxy.ansibro.svc.cluster.local:4180/
    trustForwardHeader: true
    authResponseHeaders: [X-Auth-Request-User, X-Auth-Request-Email]
{% endif %}
{% if tls == 'custom' %}
---
# Your own certificate for every site.
apiVersion: v1
kind: Secret
metadata:
  name: default-certificate
  namespace: kube-system
type: kubernetes.io/tls
data:
  tls.crt: {{ lookup('ansible.builtin.file', tls_cert) | b64encode }}
  tls.key: {{ lookup('ansible.builtin.file', tls_key) | b64encode }}
---
apiVersion: traefik.io/v1alpha1
kind: TLSStore
metadata:
  name: default
  namespace: kube-system
spec:
  defaultCertificate:
    secretName: default-certificate
{% endif %}
---
# The Traefik dashboard, at https://traefik.<domain> with the admin login.
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: dashboard
  namespace: kube-system
spec:
  entryPoints: [websecure]
  routes:
    - match: Host(`{{ traefik_host }}`)
      kind: Rule
      middlewares:
        - { name: admin-ip, namespace: ansibro }
        - { name: {{ k3s_admin_login }}, namespace: ansibro }
      services:
        - { name: api@internal, kind: TraefikService }
