{# The monitors the installer adds to Uptime Kuma (see setup.js.j2). Made by ansibro. #}
{% set monitors = [] %}
{% if 'traefik' in apps %}
{% for app in apps if app in uptimekuma_pages %}
{%   set page = uptimekuma_pages[app] %}
{%   set monitor = {
       'type': 'keyword' if page.keyword is defined else 'http',
       'name': page.host ~ ' web page',
       'ignoreTls': true,
       'accepted_statuscodes': page.codes | default(['200-299']),
       'maxredirects': 0,
     } %}
{%   if page.port is defined %}
{#     Straight to the app on its server (the firewall lets the other servers in). #}
{%     set _ = monitor.update({'url': 'http://' ~ hostvars[app_nodes[app][0]].node_ip ~ ':' ~ page.port ~ page.path}) %}
{%   else %}
{#     Through Traefik with the page's name, so it works without DNS. #}
{%     set _ = monitor.update({
         'url': 'https://' ~ traefik_ip ~ page.path,
         'headers': {'Host': page.host ~ '.' ~ domain} | to_json,
       }) %}
{%   endif %}
{%   if page.keyword is defined %}
{%     set _ = monitor.update({'keyword': page.keyword}) %}
{%   endif %}
{%   set _ = monitors.append(monitor) %}
{% endfor %}
{% endif %}
{% if monitoring_app %}
{#   Alertmanager asks for a login. setup.js adds the password (from stdin, it is not in this file). #}
{%   set _ = monitors.append({
       'type': 'keyword',
       'name': 'Monitoring server (its Watchdog alert)',
       'url': 'http://' ~ monitoring_ip ~ ':9093/api/v2/alerts?filter=alertname=Watchdog',
       'keyword': 'Watchdog',
       'authMethod': 'basic',
       'basic_auth_user': alertmanager_user,
     }) %}
{% endif %}
{{ monitors | to_nice_json }}
