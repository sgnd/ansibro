// Setup of Uptime Kuma: the admin user and the monitors. Made by ansibro.
// The installer runs it inside the container: "docker exec -i uptimekuma node /app/data/ansibro-setup.js".
// It talks to Uptime Kuma like its web page does (socket.io). The user and password come in through
// stdin (JSON), so the password is never on a command line; the monitors are in ansibro-monitors.json.
// First run: it makes the admin user and the monitors. A run that stopped half way is finished by
// the next one (it adds only the monitors that are missing, by name). When all are added, it writes
// ansibro-monitors-done: from then on you own the monitors, and it never adds, changes or removes one.
// One exception: a monitor that logs in (the monitoring server's Watchdog check, Alertmanager asks for
// a login) gets its password from stdin too, and every run sets that login again on the monitor the
// installer made (same name and address), so it keeps working when the password changes.
// Every run checks the saved password works, else it stops with an error.
const { io } = require("/app/node_modules/socket.io-client");
const fs = require("fs");
const doneFile = "/app/data/ansibro-monitors-done";

let input = "";
process.stdin.on("data", (chunk) => (input += chunk));
process.stdin.on("end", () => run(JSON.parse(input)).catch((e) => fail(e.message)));

function fail(message) {
  console.error("error: " + message);
  process.exit(1);
}

// Send an event and wait for Uptime Kuma's answer (at most 20 seconds, then fail: the installer tries again).
function call(socket, event, ...args) {
  return new Promise((resolve) => {
    const timer = setTimeout(() => fail("no answer to " + event), 20000);
    socket.emit(event, ...args, (answer) => {
      clearTimeout(timer);
      resolve(answer);
    });
  });
}

// The fields a new monitor needs, like the web page fills them in.
const defaults = {
  type: "http", method: "GET", interval: 60, retryInterval: 60, resendInterval: 0, maxretries: 1,
  timeout: 48, maxredirects: 10, accepted_statuscodes: ["200-299"], ignoreTls: false, upsideDown: false,
  expiryNotification: false, notificationIDList: {}, httpBodyEncoding: "json", body: "", headers: "",
  authMethod: null, packetSize: 56, dns_resolve_type: "A", dns_resolve_server: "1.1.1.1",
  kafkaProducerBrokers: [], kafkaProducerSaslOptions: { mechanism: "None" }, conditions: [],
};

async function run(settings) {
  const socket = io("http://localhost:3001", { transports: ["websocket"], reconnection: false });
  // After the login, Uptime Kuma sends the list of monitors.
  const monitorList = new Promise((resolve) => socket.on("monitorList", resolve));
  await new Promise((resolve) => {
    socket.on("connect", resolve);
    socket.on("connect_error", (e) => fail("cannot reach Uptime Kuma: " + e.message));
  });
  // Uptime Kuma sets up its answers a moment after a connection opens; a question sent before is lost.
  await new Promise((resolve) => setTimeout(resolve, 3000));

  let created = "";
  if (await call(socket, "needSetup")) {
    const answer = await call(socket, "setup", settings.username, settings.password);
    if (!answer.ok) fail("setup: " + answer.msg);
    created = "created the admin user, ";
  }
  let answer = await call(socket, "login", { username: settings.username, password: settings.password, token: "" });
  if (!answer.ok || answer.tokenRequired) {
    fail("Uptime Kuma has an admin user, but the saved password (state/secrets/uptimekuma_admin) does not work. "
      + "Someone else may have set it up first: check it. If you changed the password, put the new one in that file.");
  }

  const timer = setTimeout(() => fail("no list of monitors"), 20000);
  const list = Object.values(await monitorList);
  clearTimeout(timer);
  const monitors = JSON.parse(fs.readFileSync("/app/data/ansibro-monitors.json", "utf8"));
  for (const monitor of monitors.filter((m) => m.authMethod === "basic")) {
    monitor.basic_auth_pass = settings.alertmanagerPassword;
  }

  // The login of the monitors that log in, on the ones the installer made. Like the web page does it:
  // the monitor as Uptime Kuma sent it, with the new login.
  let updated = "";
  for (const monitor of monitors.filter((m) => m.authMethod === "basic")) {
    const old = list.find((m) => m.name === monitor.name && m.url === monitor.url);
    if (old && (old.authMethod !== "basic" || old.basic_auth_user !== monitor.basic_auth_user
        || old.basic_auth_pass !== monitor.basic_auth_pass)) {
      answer = await call(socket, "editMonitor", { ...old, authMethod: "basic",
        basic_auth_user: monitor.basic_auth_user, basic_auth_pass: monitor.basic_auth_pass });
      if (!answer.ok) fail("monitor " + monitor.name + ": " + answer.msg);
      updated += "updated the login of " + monitor.name + ", ";
    }
  }

  if (fs.existsSync(doneFile)) {
    console.log(updated || "nothing to do");
    process.exit(0);
  }
  const existing = list.map((monitor) => monitor.name);
  const missing = monitors.filter((monitor) => !existing.includes(monitor.name));
  for (const monitor of missing) {
    answer = await call(socket, "add", { ...defaults, ...monitor });
    if (!answer.ok) fail("monitor " + monitor.name + ": " + answer.msg);
  }
  fs.writeFileSync(doneFile, "All monitors were added. Made by ansibro: from now on you own the monitors.\n");
  console.log(missing.length || created || updated ? created + updated + "created " + missing.length + " monitors" : "nothing to do");
  process.exit(0);
}
