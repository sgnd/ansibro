services:
  valkey:
    image: {{ image_ref.valkey }}
    container_name: valkey
    restart: always
    # Host network: the firewall decides who can connect.
    network_mode: host
    command: ["valkey-server", "/etc/valkey.conf"]
    environment:
      # valkey-cli reads the password from REDISCLI_AUTH, so it is not visible in the process list.
      REDISCLI_AUTH: "{{ valkey_password }}"
    volumes:
      - ./valkey.conf:/etc/valkey.conf:ro
{% if valkey_ha %}
      - ./replica.conf:/etc/valkey-replica.conf:ro
{% endif %}
      - ./data:/data
    healthcheck:
      test: ["CMD-SHELL", "valkey-cli ping | grep PONG"]
      interval: 10s
      timeout: 5s
      retries: 5
{% if valkey_ha %}

  # Watches the primary and picks a new one when it is down. Apps can ask it where the primary is.
  valkey-sentinel:
    image: {{ image_ref.valkey }}
    container_name: valkey-sentinel
    restart: always
    network_mode: host
    command: ["valkey-server", "/etc/sentinel/sentinel.conf", "--sentinel"]
    environment:
      REDISCLI_AUTH: "{{ valkey_password }}"
    volumes:
      - ./sentinel:/etc/sentinel  # Sentinel writes to its file
{% endif %}
